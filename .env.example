# Public product name shown in the header, footer, and page titles.
NEXT_PUBLIC_APP_NAME=GameLens

# Canonical site origin used for Open Graph absolute URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL for the Steam Storefront review API. Kept configurable so a
# mock/proxy endpoint can be swapped in without code changes.
STEAM_BASE_URL=https://store.steampowered.com

# Reserved for a future embedding/semantic-similarity pipeline. Unused by
# the current mock-data MVP.
OPENAI_API_KEY=
